{
  "lexicon": 1,
  "id": "org.atgrp.denyJoinRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Deny a pending join request, deleting it. To approve one, write the requester's membership instead. Requires auth as the group.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["member"],
          "properties": {
            "member": {
              "type": "string",
              "format": "did"
            }
          }
        }
      },
      "errors": [
        {
          "name": "JoinRequestNotFound"
        }
      ]
    }
  }
}
